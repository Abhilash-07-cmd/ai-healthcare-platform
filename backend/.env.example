# Application Settings
APP_NAME="AI-Powered Smart Healthcare & Appointment Platform"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
# Default: MySQL. Fallback to SQLite if MySQL is not available or empty string
# MYSQL: mysql+pymysql://username:password@localhost:3306/healthcare_db
# SQLITE: sqlite:///./healthcare.db
DATABASE_URL=sqlite:///./healthcare.db

# Security & JWT
JWT_SECRET=super-secret-key-change-in-production-healthcare-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & AI Settings
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB Settings
CHROMA_DB_DIR=./chroma_db

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@healthcare.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@healthcare.com

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
